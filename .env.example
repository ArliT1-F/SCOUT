# Deployment surfaces (see docs/SURFACES.md):
# npm start / npm run website serve ONLY the public website, profiles and owner admin.
# npm run dev / npm run host serve a local broadcast host; Windows forces host mode itself.
# For direct server/index.ts deployments only: SCOUT_SURFACE=site (default: host).
# SCOUT_SURFACE=site

# SCOUT environment template
# ---------------------------------------------------------------------------------------------
# SCOUT does not require a .env file: every setting below has a working default (or is optional),
# and real environment variables always win over this file.
#
# To use it in a checkout:
#
#   cp .env.example .env
#   # edit .env, then run the host normally
#   npm run dev            # or: npm start
#
# In a Windows installer install the same file lives in the data directory and is picked up with
# no command prompt at all:  %APPDATA%\SCOUT\.env
#
# Loaded by: `npm run dev`, `npm start`, `npm run replay` and `npm run account-service`.
# Not loaded by: `npm test` (tests set their own environment) or the Vite browser build.
# Point SCOUT_ENV_FILE at a different path if you keep the file elsewhere.
#
# A line that is commented out is the default. Uncomment only what you need.
# This file holds secrets once you fill it in: keep it out of git (`.env` is gitignored),
# and `chmod 600 .env` on a shared machine.
# =============================================================================================

# ---------------------------------------------------------------------------------------------
# Host basics
# ---------------------------------------------------------------------------------------------

# Port the panel, overlay pages, /gsi and the WebSocket feed listen on. Default 8080.
# PORT=8080

# Token CS2 must send with Game State Integration packets. Must match the `auth token` in
# config/gamestate_integration_overlay.cfg. The built-in fallback is CHANGE_ME — set this before
# changing the cfg token. Never shown by the API or the panel.
# GSI_TOKEN=CHANGE_ME

# Primary Owner token for the operator panel. Unset, the host generates one per run and prints a
# one-time unlock link in the console. Set it only if you want one stable token across restarts.
# SCOUT_PANEL_TOKEN=

# off = reject remote panel sessions/tokens (public overlay output is unaffected).
# SCOUT_REMOTE=off

# 1 = even the host machine has to unlock the panel with the token.
# SCOUT_REQUIRE_TOKEN=1

# Comma-separated hostnames a reverse proxy/tunnel may present in Host (only yours).
# SCOUT_ALLOWED_HOSTS=scout.example.com

# 1 = record accepted GSI payloads to recordings/ (token stripped). The panel can do this too.
# LOG_GSI=1

# ---------------------------------------------------------------------------------------------
# OBS Studio bridge (optional)
# ---------------------------------------------------------------------------------------------

# Setting this switches the OBS integration ON and points it at OBS's WebSocket server.
# OBS_WS_URL=ws://127.0.0.1:4455

# OBS Tools > WebSocket Server Settings password, if OBS has one. Environment only — it is never
# saved to config, returned by the API or included in an event package.
# OBS_WS_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Closed beta: accounts, whitelist, launcher licence
# ---------------------------------------------------------------------------------------------

# The SCOUT platform owner's ACCOUNT EMAIL. Only that signed-in account may use platform settings;
# explicitly configured beta reviewers may access application review. There is no owner password variable: the
# owner applies at /apply, is approved, and sets a password through the one-time invite link.
# Set the same address on the central host AND on the hosted account service.
# SCOUT_OWNER_EMAIL=you@example.com

# Hosted account service URL. Unset = accounts live locally in config/beta/store.json.
# This is NOT the platform URL (see SCOUT_PLATFORM_URL below).
# SCOUT_BETA_API_URL=https://accounts.example.com

# Shared service key for hosted account administration. Generate one with `openssl rand -hex 24`
# and set the SAME value on the account service and the central host. Do not ship it to venues.
# SCOUT_BETA_API_KEY=

# Where the local account store lives when no hosted service is configured. Default config/beta/.
# SCOUT_BETA_DIR=config/beta

# Development only: auto-approve applications on arrival so a fresh checkout can log in.
# Never enable this on a public deployment.
# SCOUT_BETA_AUTO_APPROVE=1

# 1 = a refusal from the account service actually hides the launcher overlay (off by default, so an
# account-service outage can never take a live broadcast off air).
# SCOUT_REQUIRE_LICENCE=1

# What the dashboard's download card points at.
# SCOUT_DOWNLOAD_URL=https://github.com/ArliT1-F/SCOUT/releases/latest
# SCOUT_DOWNLOAD_VERSION=0.1.0
# SCOUT_DOWNLOAD_NOTES=

# ---------------------------------------------------------------------------------------------
# Hosted account service (`npm run account-service`)
# ---------------------------------------------------------------------------------------------
# This process reads the same file. PORT is shared with the host, so if both run on one machine
# from this checkout, give the service its own port on the command line instead of here:
#   PORT=8790 npm run account-service

# SQLite database that holds every account, session, invite, device and platform setting.
# SCOUT_ACCOUNT_DB=config/account-service/accounts.sqlite

# Public HTTPS base URL used in invitation and password-recovery links.
# SCOUT_ACCOUNT_BASE_URL=https://accounts.example.com

# Required outbound mail configuration (Resend-compatible API by default).
# Generate a separate 32-byte encryption key; preserve it securely with backups.
# SCOUT_EMAIL_API_KEY=re_...
# SCOUT_EMAIL_FROM=SCOUT <no-reply@example.com>
# SCOUT_EMAIL_ENCRYPTION_KEY=<base64-encoded-32-random-bytes>
# SCOUT_EMAIL_API_URL=https://api.resend.com/emails

# HOST=0.0.0.0

# Initial seeds only — after the first start, change these in /admin (the persisted row wins).
# SCOUT_ACCOUNT_APPLICATIONS=closed
# SCOUT_ACCOUNT_REVIEW_NOTE=Applications open again next week.
# SCOUT_ACCOUNT_NAME=SCOUT account service

# ---------------------------------------------------------------------------------------------
# Central platform / launcher sync
# ---------------------------------------------------------------------------------------------

# Venue-host opt-in: URL of the CENTRAL SCOUT HOST (not the account service). Polls every 15 s.
# Leave unset for ordinary local operation.
# SCOUT_PLATFORM_URL=https://scout.example.com

# Where the central host keeps its platform JSON store/config receipts.
# SCOUT_PLATFORM_FILE=config/platform/store.json

# ---------------------------------------------------------------------------------------------
# Escape hatch
# ---------------------------------------------------------------------------------------------

# Read settings from a different file instead of ./.env (absolute, or relative to the cwd).
# SCOUT_ENV_FILE=/etc/scout/scout.env

# SCOUT_APP_ROOT is set by the Windows launcher/installer (and read before this file is loaded),
# so it is deliberately not a .env setting.

# ---------------------------------------------------------------------------------------------
# Cloudflare Pages (public website)
# ---------------------------------------------------------------------------------------------

# The website builds to dist/ (`npm run build`) and deploys to Cloudflare Pages. Pages project
# settings are configured in the Cloudflare dashboard or with `wrangler`; they are not .env
# settings for the website build. The Pages functions proxy /api/beta/* to the account service:
#
#   SCOUT_ACCOUNT_SERVICE_URL=https://accounts.example.com   # Pages secret, server-side only
#   SCOUT_BETA_API_KEY=...                                   # Pages secret, server-side only
#
# Local development (no production credentials):
#   PORT=8790 npm run account-service   # local account service
#   npx wrangler pages dev -b SCOUT_ACCOUNT_SERVICE_URL=http://127.0.0.1:8790 ...
# See docs/CLOUDFLARE.md.

# ---------------------------------------------------------------------------------------------
# Supabase (managed PostgreSQL for Render Free Tier / stateless deployments)
# ---------------------------------------------------------------------------------------------

# The account service and platform host boot against SQLite/local JSON by default. When
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set (see render.yaml and docs/SUPABASE.md),
# accounts, sessions, invites, devices, settings, and tournaments are hydrated from and
# persisted to the linked Supabase PostgreSQL project (qtfbtfkthtvfpjvghyop / SCOUT DB).
# DATABASE_URL=postgresql://postgres:<password>@db.qtfbtfkthtvfpjvghyop.supabase.co:6543/postgres

# Supabase project origin and keys — server-side only. The service-role key bypasses Row Level
# Security and must never reach the browser or a VITE_ variable.
# SUPABASE_URL=https://qtfbtfkthtvfpjvghyop.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...        # secret; used by the account service and platform host
# SUPABASE_ANON_KEY=...                # reserved; unused by this migration

# Version-controlled migrations:
#   supabase/migrations/001_initial_account_schema.sql
#   supabase/migrations/002_render_supabase_cutover.sql
# Apply with `supabase db push` after `supabase link`, or via the Supabase SQL Editor.

# ---------------------------------------------------------------------------------------------
# Resend (transactional email: invitations, resends, password recovery)
# ---------------------------------------------------------------------------------------------

# Existing names kept (adapted to project conventions):
#   RESEND_API_KEY         -> SCOUT_EMAIL_API_KEY   (re_test_... in dev/test mode: accepted,
#                                                       delivered nowhere)
#   EMAIL_FROM             -> SCOUT_EMAIL_FROM      (verified sender, e.g. SCOUT <…@example.com>)
#   APP_BASE_URL           -> SCOUT_ACCOUNT_BASE_URL (origin of invite/recovery links)
#
# SCOUT_EMAIL_API_KEY=re_...
# SCOUT_EMAIL_FROM=SCOUT <no-reply@example.com>
# SCOUT_ACCOUNT_BASE_URL=https://accounts.example.com
# SCOUT_EMAIL_API_URL=https://api.resend.com/emails   # loopback URL allowed for local development
# SCOUT_EMAIL_ENCRYPTION_KEY=<base64-encoded-32-random-bytes>
#
# Development/testing: use a `re_test_*` key (Resend accepts but does not deliver) or point
# SCOUT_EMAIL_API_URL at a loopback stub so no real user is ever emailed. Invitation approval
# fails visibly (503 email-not-configured) when mail is not configured — it never silently
# succeeds or prints the API key.
