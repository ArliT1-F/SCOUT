# Security headers for the SCOUT public website (Cloudflare Workers serves `dist/` as static
# assets, so this file lives in `public/` and is copied to the build output by Vite).
#
# These headers are additive to the ones the origin already sets (`Referrer-Policy: no-referrer`
# on every response via server/index.ts, `X-Request-Id` on API responses).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
